# API the whole app talks to (forms, clients, appointments, integrations...).
# Leave empty to use production (https://admin.pmuforms.com/).
# Setting it to a local API (e.g. http://localhost:3003) switches EVERY request
# to that server, so pages only show data that exists in the local database.
VITE_API_BASE_URL=

# Subscription Plans
VITE_WEEKLY_PRICE=
VITE_WEEKLY_PRICE_ID=
VITE_MONTHLY_PRICE=
VITE_MONTHLY_PRICE_ID=
VITE_YEARLY_PRICE=
VITE_YEARLY_PRICE_ID=
# Google Tag Manager container for ad conversion events (sign_up, purchase).
# Optional; leave empty to turn analytics off. Same container as pmuforms.com is fine.
VITE_GTM_ID=
